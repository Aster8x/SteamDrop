{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamDrop",
  "mainBinaryName": "SteamDrop",
  "version": "0.1.0",
  "identifier": "io.github.aster8x.steamdrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SteamDrop",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "create": false,
        "backgroundColor": "#0d111a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' art: http://art.localhost data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "SteamDrop contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Add local game folders to Steam with artwork",
    "longDescription": "SteamDrop watches your game folders and adds new games to your Steam library as non-Steam shortcuts, with artwork.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/Aster8x/SteamDrop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
